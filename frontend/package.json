{
  "name": "frontend",
  "private": true,
  "version": "1.2.3",
  "author": "Jorge Ramos <jrbramosjr1985@gmail.com>",
  "homepage": "https://github.com/bramosjr/khat",
  "repository": "https://github.com/bramosjr/khat",
  "description": "MarkItDown GUI - A modern interface for document conversion",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.bramosjr.markitdown",
    "productName": "Khat MarkItDown",
    "icon": "public/icone.png",
    "directories": {
      "output": "release"
    },
    "extraResources": [
      {
        "from": "../backend/dist/markitdown-backend",
        "to": "markitdown-backend"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "deb",
        "rpm",
        "AppImage",
        "flatpak"
      ]
    },
    "flatpak": {
      "runtimeVersion": "23.08"
    }
  }
}