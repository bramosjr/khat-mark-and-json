{
  "name": "khat-mark-and-json",
  "private": true,
  "version": "0.1.2",
  "productName": "Khat Mark And Json",
  "desktopName": "khat-mark-and-json.desktop",
  "author": "Jorge Ramos <jrbramosjr1985@gmail.com>",
  "homepage": "https://github.com/bramosjr/khat-mark-and-json",
  "repository": "https://github.com/bramosjr/khat-mark-and-json",
  "description": "MarkItDown GUI - A modern interface for document conversion",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron . --no-sandbox\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12",
    "wait-on": "^9.0.10"
  },
  "main": "main.cjs",
  "build": {
    "appId": "com.bramosjr.markitdown",
    "productName": "Khat Mark And Json",
    "icon": "public/icone.png",
    "files": [
      "*.cjs",
      "!*.test.cjs",
      "dist/**/*",
      "public/icone.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },

    "mac": {
      "category": "public.app-category.productivity",
      "extraResources": [
        {
          "from": "../backend/dist/markitdown-backend",
          "to": "markitdown-backend"
        },
        {
          "from": "../backend/dist/version-info.json",
          "to": "version-info.json"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE-MIT.txt"
        },
        {
          "from": "../licenses/AGPL-3.0.txt",
          "to": "licenses/AGPL-3.0.txt"
        },
        {
          "from": "../NOTICE.md",
          "to": "licenses/NOTICE.md"
        },
        {
          "from": "../backend/dist/LICENCAS-TERCEIROS.txt",
          "to": "licenses/LICENCAS-TERCEIROS.txt"
        }
      ]
    },
    "win": {
      "target": ["nsis"],
      "extraResources": [
        {
          "from": "../backend/dist/markitdown-backend.exe",
          "to": "markitdown-backend.exe"
        },
        {
          "from": "../backend/dist/version-info.json",
          "to": "version-info.json"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE-MIT.txt"
        },
        {
          "from": "../licenses/AGPL-3.0.txt",
          "to": "licenses/AGPL-3.0.txt"
        },
        {
          "from": "../NOTICE.md",
          "to": "licenses/NOTICE.md"
        },
        {
          "from": "../backend/dist/LICENCAS-TERCEIROS.txt",
          "to": "licenses/LICENCAS-TERCEIROS.txt"
        }
      ]
    },
    "linux": {
      "target": ["deb", "rpm", "AppImage", "pacman"],
      "icon": "build/icons",
      "syncDesktopName": true,
      "category": "Utility",
      "extraResources": [
        {
          "from": "../backend/dist/markitdown-backend",
          "to": "markitdown-backend"
        },
        {
          "from": "../backend/dist/version-info.json",
          "to": "version-info.json"
        },
        {
          "from": "../LICENSE",
          "to": "licenses/LICENSE-MIT.txt"
        },
        {
          "from": "../licenses/AGPL-3.0.txt",
          "to": "licenses/AGPL-3.0.txt"
        },
        {
          "from": "../NOTICE.md",
          "to": "licenses/NOTICE.md"
        },
        {
          "from": "../backend/dist/LICENCAS-TERCEIROS.txt",
          "to": "licenses/LICENCAS-TERCEIROS.txt"
        }
      ]
    },
    "deb": {
      "fpm": [
        "build/khat-mark-and-json.metainfo.xml=/usr/share/metainfo/khat-mark-and-json.metainfo.xml",
        "build/copyright=/usr/share/doc/khat-mark-and-json/copyright"
      ]
    },
    "flatpak": {
      "runtimeVersion": "23.08"
    }
  }
}